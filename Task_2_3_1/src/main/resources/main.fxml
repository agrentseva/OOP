<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.nsu.ga.grentseva.snake.controller.GameController"
            onKeyPressed="#onKeyPressed"
            focusTraversable="true"
            style="-fx-background-color: #578A34;">

    <top>
        <HBox alignment="CENTER"
              spacing="40"
              style="-fx-padding: 15; -fx-background-color: #4A752C; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);">

            <Label fx:id="scoreLabel"
                   text="Score: 0"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Label fx:id="targetLabel"
                   text="Target: 10"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

            <Label fx:id="levelLabel"
                   text="Level: 1"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>

        </HBox>
    </top>


    <center>
        <HBox alignment="CENTER"
              style="-fx-padding: 20;">

            <Canvas fx:id="canvas"/>

        </HBox>
    </center>


    <bottom>
        <HBox alignment="CENTER"
              style="-fx-padding: 15; -fx-background-color: #4A752C;">

            <Label fx:id="legendLabel"
                   text="Legend"
                   style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;"/>

        </HBox>
    </bottom>

</BorderPane>