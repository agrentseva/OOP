<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="ru.nsu.ga.grentseva.snake.controller.MenuController"
           style="-fx-background-color: #A2D149;">

    <VBox alignment="CENTER"
          spacing="25"
          prefWidth="800"
          prefHeight="600">

        <Label fx:id="titleLabel"
               text="Snake"
               style="-fx-font-size: 64px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 10, 0, 2, 2);"/>


        <Button fx:id="playButton"
                onAction="#onPlay"
                prefWidth="250"
                prefHeight="60"
                onMouseEntered="#onHover"
                onMouseExited="#onExitHover"
                style="-fx-background-color: #4A752C; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>

        <Button fx:id="playEndlessButton"
                onAction="#onPlayEndless"
                prefWidth="250"
                prefHeight="60"
                onMouseEntered="#onHover"
                onMouseExited="#onExitHover"
                style="-fx-background-color: #4A752C; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>

        <Button fx:id="exitButton"
                onAction="#onExit"
                prefWidth="250"
                prefHeight="60"
                onMouseEntered="#onHoverExit"
                onMouseExited="#onExitHoverExit"
                style="-fx-background-color: #E7471D; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-size: 20px; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"/>


        <HBox alignment="CENTER"
              spacing="10"
              style="-fx-padding: 20 0 0 0;">

            <Label fx:id="languageLabel"
                   text="Language:"
                   style="-fx-font-size: 18px; -fx-text-fill: #333333; -fx-font-weight: bold;"/>

            <ChoiceBox fx:id="languageBox"
                       prefWidth="150"
                       style="-fx-font-size: 14px; -fx-background-color: white; -fx-background-radius: 5;"/>

        </HBox>

    </VBox>

</StackPane>